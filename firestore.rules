rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function membershipPath(libraryId) {
      return /databases/$(database)/documents/libraries/$(libraryId)/memberships/$(request.auth.uid);
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function normalizedAuthEmail() {
      return authEmail().lower();
    }

    function invitePath(email) {
      return /databases/$(database)/documents/membership_invites/$(email);
    }

    function membershipForUserPath(libraryId, userId) {
      return /databases/$(database)/documents/libraries/$(libraryId)/memberships/$(userId);
    }

    function isLibraryMember(libraryId) {
      return isSignedIn() && exists(membershipPath(libraryId));
    }

    function libraryRole(libraryId) {
      return get(membershipPath(libraryId)).data.role;
    }

    function isLibraryOwner(libraryId) {
      return isLibraryMember(libraryId) && libraryRole(libraryId) == 'owner';
    }

    match /libraries/{libraryId} {
      allow read: if isLibraryMember(libraryId)
        || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.name is string;
      allow update, delete: if false;

      match /memberships/{userId} {
        allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn()
          && (
            (
              userId == request.auth.uid
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.role == 'owner'
              && getAfter(/databases/$(database)/documents/libraries/$(libraryId)).data.ownerUserId == request.auth.uid
            )
            ||
            (
              isLibraryOwner(libraryId)
              && request.resource.data.userId == userId
              && request.resource.data.role == 'viewer'
            )
            ||
            (
              userId == request.auth.uid
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.role == 'viewer'
              && authEmail() != null
              && exists(invitePath(normalizedAuthEmail()))
              && get(invitePath(normalizedAuthEmail())).data.primaryLibraryId == libraryId
              && get(invitePath(normalizedAuthEmail())).data.role == 'viewer'
            )
          );
        allow update, delete: if false;
      }
    }

    match /user_memberships/{userId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == userId
        && (
          (
            userId == request.auth.uid
            && request.resource.data.role == 'owner'
            && getAfter(/databases/$(database)/documents/libraries/$(request.resource.data.primaryLibraryId)).data.ownerUserId == request.auth.uid
          )
          ||
          (
            isLibraryOwner(request.resource.data.primaryLibraryId)
            && request.resource.data.role == 'viewer'
          )
          ||
          (
            userId == request.auth.uid
            && request.resource.data.role == 'viewer'
            && authEmail() != null
            && request.resource.data.email == normalizedAuthEmail()
            && exists(invitePath(normalizedAuthEmail()))
            && get(invitePath(normalizedAuthEmail())).data.primaryLibraryId == request.resource.data.primaryLibraryId
            && get(invitePath(normalizedAuthEmail())).data.role == 'viewer'
          )
        );
      allow update: if isSignedIn()
        && request.resource.data.userId == userId
        && (
          (
            userId == request.auth.uid
            && exists(membershipForUserPath(request.resource.data.primaryLibraryId, userId))
            && request.resource.data.role == get(membershipForUserPath(request.resource.data.primaryLibraryId, userId)).data.role
          )
          ||
          (
            isLibraryOwner(request.resource.data.primaryLibraryId)
            && request.resource.data.role == 'viewer'
          )
        );
      allow delete: if false;
    }

    match /membership_invites/{email} {
      allow read: if isSignedIn() && authEmail() != null && email == normalizedAuthEmail();
      allow create, update: if isSignedIn()
        && isLibraryOwner(request.resource.data.primaryLibraryId)
        && request.resource.data.role == 'viewer'
        && request.resource.data.email == email;
      allow delete: if isSignedIn()
        && (
          (authEmail() != null && email == normalizedAuthEmail())
          || isLibraryOwner(resource.data.primaryLibraryId)
        );
    }

    match /books/{bookId} {
      allow read: if isLibraryMember(resource.data.libraryId);
      allow create: if isLibraryOwner(request.resource.data.libraryId);
      allow update, delete: if isLibraryOwner(resource.data.libraryId);
    }

    match /book_notes/{noteId} {
      allow read: if isLibraryMember(resource.data.libraryId);
      allow create: if isLibraryOwner(request.resource.data.libraryId);
      allow update, delete: if isLibraryOwner(resource.data.libraryId);
    }

    match /reading_state/{stateId} {
      allow read: if isLibraryMember(resource.data.libraryId) && resource.data.userId == request.auth.uid;
      allow create: if isLibraryMember(request.resource.data.libraryId) && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isLibraryMember(resource.data.libraryId) && resource.data.userId == request.auth.uid;
    }
  }
}
