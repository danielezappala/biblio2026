rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function membershipPath(libraryId) {
      return /databases/$(database)/documents/libraries/$(libraryId)/memberships/$(request.auth.uid);
    }

    function isLibraryMember(libraryId) {
      return isSignedIn() && exists(membershipPath(libraryId));
    }

    function libraryRole(libraryId) {
      return get(membershipPath(libraryId)).data.role;
    }

    function isLibraryOwner(libraryId) {
      return isLibraryMember(libraryId) && libraryRole(libraryId) == 'owner';
    }

    match /libraries/{libraryId} {
      allow read: if isLibraryMember(libraryId);
      allow create: if isSignedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.name is string;
      allow update, delete: if false;

      match /memberships/{userId} {
        allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn()
          && (
            (
              userId == request.auth.uid
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.role == 'owner'
              && getAfter(/databases/$(database)/documents/libraries/$(libraryId)).data.ownerUserId == request.auth.uid
            )
            ||
            (
              isLibraryOwner(libraryId)
              && request.resource.data.userId == userId
              && request.resource.data.role == 'viewer'
            )
          );
        allow update, delete: if false;
      }
    }

    match /books/{bookId} {
      allow read: if isLibraryMember(resource.data.libraryId);
      allow create: if isLibraryOwner(request.resource.data.libraryId);
      allow update, delete: if isLibraryOwner(resource.data.libraryId);
    }

    match /book_notes/{noteId} {
      allow read: if isLibraryMember(resource.data.libraryId);
      allow create: if isLibraryOwner(request.resource.data.libraryId);
      allow update, delete: if isLibraryOwner(resource.data.libraryId);
    }

    match /reading_state/{stateId} {
      allow read: if isLibraryMember(resource.data.libraryId) && resource.data.userId == request.auth.uid;
      allow create: if isLibraryMember(request.resource.data.libraryId) && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isLibraryMember(resource.data.libraryId) && resource.data.userId == request.auth.uid;
    }
  }
}
